# ── Hermes Agent ─────────────────────────────────────────────────────────────
# Opción 1 (recomendada): endpoint HTTP/SSE de Hermes Agent.
# El servidor enviará POST JSON: { message, history, sessionId, inputMode }.
HERMES_AGENT_URL=""

# Token opcional para HERMES_AGENT_URL (se envía como Bearer).
HERMES_AGENT_API_KEY=""

# Cabeceras HTTP extra opcionales en formato JSON.
# Ejemplo: HERMES_AGENT_HEADERS={"X-Project":"hermes"}
HERMES_AGENT_HEADERS=""

# Opción 2: proceso/CLI local de Hermes Agent.
# Recibe el mensaje por stdin y también en la variable HERMES_MESSAGE.
# El stdout se transmite al frontend en tiempo real.
# Ejemplo: HERMES_AGENT_COMMAND="hermes agent --stream"
HERMES_AGENT_COMMAND=""

# Tiempo máximo de respuesta del proceso local en milisegundos.
HERMES_AGENT_TIMEOUT_MS="120000"

# Puerto del servidor (por defecto 4000).
PORT="4000"

# ── Fallback opcional ────────────────────────────────────────────────────────
# Si no hay Hermes configurado, se puede usar Gemini como respaldo.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: URL pública donde está alojado el centro de mando.
APP_URL="MY_APP_URL"
